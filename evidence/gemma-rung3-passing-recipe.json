{
  "description": "Trims whitespace from merchant, normalizes date to YYYY-MM-DD, and parses amount to two decimal places.",
  "input_contract": {
    "preserve_extra_columns": true,
    "required_columns": [
      "transaction_id",
      "date",
      "merchant",
      "amount",
      "category",
      "notes"
    ]
  },
  "name": "Trim, Normalize Date, Parse Decimal",
  "operations": [
    {
      "columns": [
        "merchant"
      ],
      "type": "trim"
    },
    {
      "column": "date",
      "input_formats": [
        "%m/%d/%Y",
        "%Y-%m-%d"
      ],
      "on_error": "fail",
      "output_format": "%Y-%m-%d",
      "type": "coerce_date"
    },
    {
      "column": "amount",
      "decimal_places": 2,
      "decimal_separator": ".",
      "on_error": "fail",
      "thousands_separator": ",",
      "type": "parse_decimal"
    }
  ],
  "output_contract": {
    "preserve_extra_columns": true,
    "required_columns": [
      "transaction_id",
      "date",
      "merchant",
      "amount",
      "category",
      "notes"
    ]
  },
  "schema_version": 1
}
