# Molt local runtime configuration. Copy to .env and edit as needed.
MOLT_DATA_DIR=workspace
MOLT_HOST=127.0.0.1
MOLT_PORT=8765
MOLT_MAX_UPLOAD_MB=10
MOLT_MAX_ROWS=100000
MOLT_MAX_OPERATIONS=30
MOLT_MAX_RECIPE_KB=128
MOLT_MAX_EXECUTION_SECONDS=120
MOLT_POLL_INTERVAL_SECONDS=1.5

# Ollama/Gemma. Install Ollama separately, start it, then pull this tag.
OLLAMA_BASE_URL=http://127.0.0.1:11434
MOLT_GEMMA_MODEL=gemma3:4b
MOLT_MODEL_TIMEOUT_SECONDS=30
MOLT_MODEL_MAX_RETRIES=2
MOLT_MODEL_MAX_RESPONSE_KB=512

# Keep true for local-only operation. Molt never falls back to hosted inference.
MOLT_LOCAL_ONLY=true

# Optional. Telemetry is disabled when empty and never blocks Molt.
SENTRY_DSN=

# Optional and non-blocking. The core API supports supervised binary triage
# only; it does not fabricate unlabeled anomaly scores. Verify the selected
# TabPFN model-weight terms before setting the acknowledgment flag.
MOLT_TABPFN_ENABLED=false
MOLT_TABPFN_LICENSE_ACCEPTED=false
MOLT_TABPFN_MODEL=default
MOLT_TABPFN_DEVICE=auto
MOLT_TABPFN_MAX_ROWS=5000

# Optional Temporal durable execution. Disabled unless the optional SDK and
# a reachable Temporal server are installed/configured.
MOLT_TEMPORAL_ADDRESS=127.0.0.1:7233
MOLT_TEMPORAL_NAMESPACE=default
MOLT_TEMPORAL_TASK_QUEUE=molt
MOLT_TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=300
