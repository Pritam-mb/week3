{
  "git.countBadge": "tracked",
  "git.autorefresh": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/mastra-repair/node_modules/**": true,
    "**/.mastra/**": true,
    "**/workspace/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/mastra-repair/node_modules": true,
    "**/.mastra": true,
    "**/workspace": true
  }
}
